# Hyperliquid: use an API/agent wallet key (trade-only, cannot withdraw), NOT your main wallet key.
HL_ACCOUNT_ADDRESS=0xYourMainAccountAddress
HL_SECRET_KEY=0xYourApiAgentPrivateKey
HL_NETWORK=testnet          # testnet | mainnet
LIVE=false                  # false = log decisions only, never send orders
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# Hard risk limits (enforced in code, Claude cannot override)
STRATEGY=rule              # rule = backtested momentum rules (free); claude = LLM decisions (untested)
COINS=BTC,ETH,SOL
MAX_LEVERAGE=3
MAX_POSITION_PCT=0.50       # max notional per position as fraction of equity
MAX_TOTAL_EXPOSURE_PCT=1.00 # max total notional as fraction of equity
MAX_RISK_PER_TRADE_PCT=0.01 # equity lost if stop-loss hits
MAX_DAILY_LOSS_PCT=0.03     # kill switch: stop opening trades for the day
DAILY_PROFIT_TARGET_PCT=0      # 0 = off. >0: at that gain close all, stop until next UTC day
MAX_MONTHLY_LOSS_PCT=0.08     # kill switch: stop for the month at -8%
MIN_CONFIDENCE=0.6
LOOP_SECONDS=3600
UI_PORT=8080                # dashboard at http://127.0.0.1:8080/dashboard.html (localhost only); 0 = off
START_PAUSED=false          # true = start with new trades paused until you press Resume on the dashboard
DD_DERISK_PCT=0.08          # shrink position size as drawdown from peak grows (half size at -4%, floor at MIN_RISK_SCALE); 0 = off
MIN_RISK_SCALE=0.25
MAX_POSITIONS=3
