# Hyperliquid: use an API/agent wallet key (trade-only, cannot withdraw), NOT your main wallet key.
HL_ACCOUNT_ADDRESS=0xYourMainAccountAddress
HL_SECRET_KEY=0xYourApiAgentPrivateKey
HL_NETWORK=testnet          # testnet | mainnet
LIVE=false                  # false = log decisions only, never send orders
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# Hard risk limits (enforced in code, Claude cannot override)
COINS=BTC,ETH,SOL
MAX_LEVERAGE=3
MAX_POSITION_PCT=0.20       # max notional per position as fraction of equity
MAX_TOTAL_EXPOSURE_PCT=0.50 # max total notional as fraction of equity
MAX_RISK_PER_TRADE_PCT=0.01 # equity lost if stop-loss hits
MAX_DAILY_LOSS_PCT=0.03     # kill switch: stop opening trades for the day
MIN_CONFIDENCE=0.6
LOOP_SECONDS=900
